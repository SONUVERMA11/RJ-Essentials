              "neverError": true
            }
          }
        }
      },
      "id": "a1b2c3d4-3333-4aaa-bbbb-000000000003",
      "name": "1. Scrape Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 400]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst data = items[0].json;\n\nif (!data.success) {\n  return [{ json: { error: data.error || 'Scraper failed', step: 'scrape' } }];\n}\n\nconst totalProducts = data.data?.metadata?.totalProducts || 0;\nreturn [{ json: { \n  success: true, \n  step: 'scrape',\n  totalProducts,\n  message: `Scraped ${totalProducts} products`\n} }];"
      },
      "id": "a1b2c3d4-3344-4aaa-bbbb-000000000033",
      "name": "Check Scrape Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-scrape-ok",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-3355-4aaa-bbbb-000000000034",
      "name": "Scrape OK?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [1020, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3456/enrich",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"skipImages\": false, \"skipAI\": false}",
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a1b2c3d4-4444-4aaa-bbbb-000000000004",
      "name": "2. Enrich with AI + Images",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 340]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst data = items[0].json;\n\nif (!data.success) {\n  return [{ json: { error: data.error || 'Enrichment failed', step: 'enrich' } }];\n}\n\nconst total = data.data?.metadata?.totalProducts || 0;\nreturn [{ json: { \n  success: true, \n  step: 'enrich',\n  totalEnriched: total,\n  message: `Enriched ${total} products with AI descriptions and multi-platform images`\n} }];"
      },
      "id": "a1b2c3d4-4455-4aaa-bbbb-000000000044",
      "name": "Check Enrich Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, 340]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-enrich-ok",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-4466-4aaa-bbbb-000000000045",
      "name": "Enrich OK?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [1740, 280]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:3456/products/flat",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a1b2c3d4-5555-4aaa-bbbb-000000000005",
      "name": "3. Load Enriched Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 280]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst firstItem = items[0].json;\n\n// If response is an array, split into individual items\nif (Array.isArray(firstItem)) {\n  if (firstItem.length === 0) {\n    return [{ json: { error: 'No products to push' } }];\n  }\n  return firstItem.map(p => ({ json: p }));\n}\n\n// If error\nif (firstItem.error) {\n  return [{ json: { error: firstItem.error } }];\n}\n\n// Single product\nif (firstItem.name) {\n  return [{ json: firstItem }];\n}\n\n// Fallback\nconst products = items.filter(i => i.json.name && i.json.sellingPrice);\nif (products.length > 0) return products;\n\nreturn [{ json: { error: 'Unexpected response format' } }];"
      },
      "id": "a1b2c3d4-5566-4aaa-bbbb-000000000055",
      "name": "Split Into Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 280]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-valid",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notExists"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-6666-4aaa-bbbb-000000000006",
      "name": "Has Valid Data",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [2460, 220]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Sanitize all Meesho references before pushing\nconst items = $input.all();\nreturn items.map(item => {\n  const p = { ...item.json };\n  \n  // Remove internal raw data\n  delete p._raw;\n  \n  // Clean Meesho from all text fields\n  const clean = (str) => (str || '').replace(/meesho/gi, '').replace(/\\s+/g, ' ').trim();\n  \n  p.name = clean(p.name);\n  p.slug = (p.slug || '').replace(/meesho-?/gi, '').replace(/-+/g, '-').replace(/(^-|-$)/g, '');\n  p.description = clean(p.description);\n  p.metaTitle = clean(p.metaTitle);\n  p.metaDescription = clean(p.metaDescription);\n  \n  // Ensure brand is RJ Essentials\n  if (!p.brand || p.brand.toLowerCase().includes('meesho')) {\n    p.brand = 'RJ Essentials';\n  }\n  \n  // Filter meesho from tags\n  if (p.tags) {\n    p.tags = p.tags.filter(t => !t.toLowerCase().includes('meesho'));\n  }\n  \n  // Clean highlights\n  if (p.highlights) {\n    p.highlights = p.highlights.map(h => clean(h)).filter(Boolean);\n  }\n  \n  return { json: p };\n});"
      },
      "id": "a1b2c3d4-6677-4aaa-bbbb-000000000066",
      "name": "4. Sanitize Products",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2700, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/products",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer agk_rje_7f3a9c2e1b4d6f8a0e3c5b7d9f1a3c5e7b9d1f3a5c7e9b1d3f5a7c9e1b3d5f"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a1b2c3d4-7777-4aaa-bbbb-000000000007",
      "name": "5. Push to RJ Essentials",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2940, 220]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nlet success = 0;\nlet failed = 0;\nconst errors = [];\n\nfor (const item of items) {\n  if (item.json.error || (item.json.statusCode && item.json.statusCode >= 400)) {\n    failed++;\n    errors.push(item.json.error || item.json.message || 'Unknown error');\n  } else {\n    success++;\n  }\n}\n\nreturn [{ json: {\n  timestamp: new Date().toISOString(),\n  pipeline: 'Scrape → Enrich → Push',\n  totalProcessed: items.length,\n  success: success,\n  failed: failed,\n  errors: errors.slice(0, 10),\n  message: `Pipeline complete: ${success} products pushed, ${failed} failed`\n} }];"
      },
      "id": "a1b2c3d4-8888-4aaa-bbbb-000000000008",
      "name": "6. Generate Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3180, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fs = require('fs');\nconst logDir = '/run/media/kaal/CodeBase/Projects/RJ/rj-essentials/n8n-automation/logs';\n\ntry {\n  if (!fs.existsSync(logDir)) {\n    fs.mkdirSync(logDir, { recursive: true });\n  }\n  const date = new Date().toISOString().split('T')[0];\n  const logFile = logDir + '/pipeline-' + date + '.log';\n  const items = $input.all();\n  for (const item of items) {\n    const entry = '[' + new Date().toISOString() + '] ' + JSON.stringify(item.json) + '\\n';\n    fs.appendFileSync(logFile, entry);\n  }\n  return items;\n} catch (e) {\n  return [{ json: { logError: e.message } }];\n}"
      },
      "id": "a1b2c3d4-9999-4aaa-bbbb-000000000009",
      "name": "7. Save Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3420, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst errors = items.filter(i => i.json.error);\n\nif (errors.length > 0) {\n  return errors.map(e => ({ json: { errorType: 'pipeline_error', detail: e.json.error } }));\n}\n\nreturn [{ json: { noErrors: true } }];"
      },
      "id": "a1b2c3d4-AAAA-4aaa-bbbb-00000000000A",
      "name": "Collect Errors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2460, 440]
    }
